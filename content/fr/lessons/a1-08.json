     [
      "*je parle*",
      "I speak",
      "/ʒə paʁl/"
     ],
     [
      "*tu parles*",
      "you speak",
      "/ty paʁl/"
     ],
     [
      "*il / elle / on parle*",
      "he / she speaks, we speak",
      "/il paʁl/"
     ],
     [
      "*nous parlons*",
      "we speak",
      "/nu paʁ.lɔ̃/"
     ],
