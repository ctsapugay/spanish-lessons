  "sections": [
    {
      "heading": "Commands for usted and ustedes",
      "body": "Formal commands use the \"opposite\" vowel: take the *yo* form of the present, drop the *-o*, and add *-e / -en* for *-ar* verbs, *-a / -an* for *-er / -ir* verbs.",
      "table": {
        "head": [
          "Infinitive",
          "yo form",
          "usted",
          "ustedes"
        ],
        "rows": [
          [
            "*hablar*",
            "*hablo*",
            "*hable*",
            "*hablen*"
          ],
          [
            "*comer*",
